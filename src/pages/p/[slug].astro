---
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import { Picture } from 'astro:assets';
import Avatar from '../../components/Avatar.astro';
import TypeTile from '../../components/post/TypeTile.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent } from '../../lib/content';
import { mediaImage } from '../../lib/media';
import { tileTone } from '../../lib/site';

export async function getStaticPaths() {
  const { posts } = await loadSiteContent();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { profile } = await loadSiteContent();
const { title, media, location, org, date, order } = post.data;
const when = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(date);
const tone = tileTone(order);
const initials = profile.displayName
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<BaseLayout title={title} current="home">
  <article class="post-page">
    <a class="back" href="/">
      <ChevronLeft size={20} aria-hidden="true" />
      <span>Back to profile</span>
    </a>
    <header class="post-head">
      <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
      <div>
        <p class="username">{profile.username}</p>
        {location && <p class="place">{location}</p>}
      </div>
    </header>
    <h1 class="visually-hidden">{title}</h1>
    <ol class="media" role="list">
      {media.map((item, i) => (
        <li class="slide" aria-label={`${i + 1} of ${media.length}`}>
          {item.type === 'image' ? (
            <Picture
              src={mediaImage(item.src)}
              alt={item.alt}
              formats={['avif', 'webp']}
              widths={[480, 720, 1080]}
              sizes="(min-width: 768px) 470px, 100vw"
            />
          ) : (
            <TypeTile headline={item.headline} detail={item.detail} tone={tone} />
          )}
        </li>
      ))}
    </ol>
    <div class="caption">
      <p>
        <strong>{profile.username}</strong>
        <span class="body">{post.body.trim()}</span>
      </p>
      <p class="meta">{[org, when].filter(Boolean).join(' · ')}</p>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    max-width: 470px;
    margin: 0 auto;
    padding: var(--space-4) 0;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0 var(--space-4) var(--space-3);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
  }

  .post-head p {
    margin: 0;
  }

  .username {
    font-weight: var(--weight-semibold);
  }

  .place {
    color: var(--text-secondary);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }

  .media {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .slide {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .caption {
    padding: var(--space-3) var(--space-4);
  }

  .caption p {
    margin: 0;
  }

  .body {
    margin-left: var(--space-1);
  }

  .meta {
    margin-top: var(--space-2) !important;
    color: var(--text-secondary);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }
</style>
