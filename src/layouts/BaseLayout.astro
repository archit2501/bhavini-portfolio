---
import '../styles/global.css';
import ContactSheet from '../components/ContactSheet.astro';
import AppBar from '../components/nav/AppBar.astro';
import BottomTabs from '../components/nav/BottomTabs.astro';
import SideNav from '../components/nav/SideNav.astro';
import type { NavId } from '../components/nav/nav-items';
import { loadSiteContent } from '../lib/content';
import { pageTitle } from '../lib/site';

interface Props {
  /** Inner pages put their name first; the home page leaves this out. */
  title?: string;
  description?: string;
  current?: NavId;
}

const { profile } = await loadSiteContent();
const {
  title,
  description = `${profile.displayName}, ${profile.category} at F1Jobs.io, ${profile.location}.`,
  current,
} = Astro.props;
const linkedinLabel = profile.links.linkedin.replace(/^https?:\/\/(www\.)?/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1014" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle(title)}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SideNav current={current} />
    <AppBar />
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer id="contact" class="site-footer">
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
          {linkedinLabel}
        </a>
        {profile.links.email && <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>}
      </footer>
    </div>
    <BottomTabs current={current} />
    <ContactSheet profile={profile} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    color: var(--on-accent);
    background: var(--accent);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-button);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .page {
    min-height: 100dvh;
    padding-bottom: calc(49px + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 768px) {
    .page {
      margin-left: 72px;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1264px) {
    .page {
      margin-left: 244px;
    }
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-8) var(--space-4);
    color: var(--text-secondary);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }

  .site-footer a {
    color: inherit;
  }
</style>
