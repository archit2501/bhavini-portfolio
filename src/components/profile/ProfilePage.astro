---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent } from '../../lib/content';
import Highlights from './Highlights.astro';
import ProfileHeader from './ProfileHeader.astro';
import ProfileTabs, { type ProfileTab } from './ProfileTabs.astro';

interface Props {
  tab: ProfileTab;
}

const { tab } = Astro.props;
const { profile, figures, highlights, posts, reels } = await loadSiteContent();
---

<!-- "/" and "/reels/" are the same profile with a different tab selected, as on Instagram. -->
<BaseLayout
  title={tab === 'reels' ? 'Reels' : undefined}
  current={tab === 'reels' ? 'reels' : 'home'}
>
  <ProfileHeader profile={profile} figures={figures} />
  <Highlights highlights={highlights} />
  <ProfileTabs selected={tab} posts={posts} reels={reels} />
</BaseLayout>
